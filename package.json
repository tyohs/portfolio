{
  "name": "yoh-kaminaga-portfolio",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1 --port 4184",
    "check": "astro check",
    "build": "astro build",
    "preview": "astro preview --host 127.0.0.1 --port 4184",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run check && npm run build && npm test",
    "deploy:dry-run": "wrangler deploy --dry-run",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "astro": "7.4.5",
    "dompurify": "3.4.17",
    "marked": "18.1.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.12",
    "typescript": "6.0.3",
    "wrangler": "4.157.0"
  }
}
