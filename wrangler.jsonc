{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "yoh-kaminaga-portfolio",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-03",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"],
    "not_found_handling": "404-page"
  },
  "vars": {
    "OPENAI_MODEL": "gpt-6-luna",
    "CHAT_EXPIRES_AT": "2026-11-25T15:00:00.000Z",
    "CHAT_DAILY_LIMIT": "100"
  },
  "durable_objects": {
    "bindings": [{ "name": "CHAT_QUOTA", "class_name": "ChatQuota" }]
  },
  "migrations": [{ "tag": "v1-chat-quota", "new_sqlite_classes": ["ChatQuota"] }]
}

